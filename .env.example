# Copy this file to .env and fill in the real values.
# .env is git-ignored; never commit it, never echo its contents.
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional relay & external providers for P1-1 / P1-3 / P1-4
HUBCORE_API_KEY=<your-hubcore-api-key>
HUBCORE_BASE_URL=https://api.hubcore.cn/v1
HUBCORE_GLM_API_KEY=<your-hubcore-glm-api-key>
HUBCORE_GLM_BASE_URL=https://api.hubcore.cn/v1
DASHSCOPE_API_KEY=<your-dashscope-qwen-api-key>
ZHIPU_API_KEY=<your-zhipu-glm-api-key>
MOONSHOT_API_KEY=<your-moonshot-kimi-api-key>
