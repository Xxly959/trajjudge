diff --git a/docs/built_in_graders/agent_graders.md b/docs/built_in_graders/agent_graders.md
index 4a1b541..7bc8c30 100644
--- a/docs/built_in_graders/agent_graders.md
+++ b/docs/built_in_graders/agent_graders.md
@@ -1064,6 +1064,11 @@ Each turn similarity: [0.0, 0.42857142857142855]
 
 ### TrajectoryAccuracyGrader
 
+For non-empty trajectories, the returned `score` is bounded to the documented
+1–3 scale. `metadata["raw_score"]` preserves the model's value before bounding,
+so callers can audit out-of-range outputs. A bounded score alone does not establish
+that the model followed the scoring rubric.
+
 Evaluates the accuracy of agent trajectories in solving user queries.
 
 **Use this grader for:**
diff --git a/openjudge/graders/agent/trajectory/trajectory_accuracy.py b/openjudge/graders/agent/trajectory/trajectory_accuracy.py
index 5709ab7..24128a6 100644
--- a/openjudge/graders/agent/trajectory/trajectory_accuracy.py
+++ b/openjudge/graders/agent/trajectory/trajectory_accuracy.py
@@ -334,7 +334,7 @@ class TrajectoryAccuracyGrader(LLMGrader):
 
         # Prepare metadata
         metadata = {
-            "raw_score": score,
+            "raw_score": result.score,
         }
 
         return GraderScore(
diff --git a/tests/graders/agent/trajectory/test_trajectory_accuracy_raw_score.py b/tests/graders/agent/trajectory/test_trajectory_accuracy_raw_score.py
new file mode 100644
index 0000000..116736a
--- /dev/null
+++ b/tests/graders/agent/trajectory/test_trajectory_accuracy_raw_score.py
@@ -0,0 +1,22 @@
+# -*- coding: utf-8 -*-
+"""Preserve unmodified model scores for downstream grader audits (offline)."""
+import asyncio
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+from openjudge.graders.agent.trajectory.trajectory_accuracy import TrajectoryAccuracyGrader
+from openjudge.graders.schema import GraderScore
+
+
+@pytest.mark.unit
+@pytest.mark.parametrize("raw_score,expected", [(-99.0, 1.0), (1.0, 1.0), (2.0, 2.0), (2.5, 2.5), (3.0, 3.0), (99.0, 3.0)])
+def test_raw_score_retains_model_value(raw_score: float, expected: float) -> None:
+    """Keep compatibility for score while exposing the pre-clamp value in metadata."""
+    parsed = GraderScore(name="trajectory_accuracy", score=raw_score, reason="Synthetic offline response")
+    grader = TrajectoryAccuracyGrader(model=AsyncMock())
+    with patch("openjudge.graders.llm_grader.LLMGrader._aevaluate", new=AsyncMock(return_value=parsed)):
+        result = asyncio.run(grader.aevaluate(messages=[{"role": "user", "content": "Synthetic task"}]))
+    assert result.score == expected
+    assert result.metadata["raw_score"] == raw_score
+    assert result.reason == "Synthetic offline response"
